# ============================================================
# SQL RAG Assistant - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- App ---
APP_NAME="SQL RAG Assistant"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Primary application database (stores users, chat history, feedback) ---
APP_DB_DRIVER=mysql+aiomysql
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_USER=rag_app_user
APP_DB_PASSWORD=App1234
APP_DB_NAME=sql_rag_app_db

# --- Target business database (the DB users ask questions about) ---
# Kept separate from the app DB on purpose: the app DB is writable,
# the target DB should generally be accessed with a read-only credential.
TARGET_DB_DRIVER=mysql+aiomysql
TARGET_DB_HOST=localhost
TARGET_DB_PORT=3306
TARGET_DB_USER=rag_readonly_user
TARGET_DB_PASSWORD=ReadOnly1234
TARGET_DB_NAME=sample_retail_db

# --- LLM Provider ---
LLM_PROVIDER=groq             # groq | openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30

# --- Embeddings (local, no API key required) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu          # cpu | cuda

# --- Vector store (FAISS) ---
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_TOP_K=5

# --- Redis (caching, local install for now) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# --- Query execution limits ---
SQL_QUERY_TIMEOUT_SECONDS=15
SQL_MAX_ROWS_RETURNED=1000
SQL_DEFAULT_LIMIT=100
